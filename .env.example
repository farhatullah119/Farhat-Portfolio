# Supabase Configuration (Required for Admin Dashboard & Live CMS)
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Site URL (Used for SEO, OpenGraph metadata, sitemap, and robots.txt)
# Use http://localhost:3000 for local development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenAI API Key (Optional — enables the "Ask Farhat AI" chatbot)
# Found at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

